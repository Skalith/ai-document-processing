# Backend configuration (loaded by backend/app/config.py via pydantic-settings).
# Copy this file to .env and fill in your keys. .env is git-ignored.

# --- LLM providers (priority: omniroute -> gemini -> groq -> nvidia -> anthropic) ---
# The first provider with a key is tried first; a failed call falls over to
# the next one, and if all fail the app falls back to plain OCR output.

# Omniroute (OpenAI-compatible gateway) — PRIMARY. Leave blank to skip.
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto
# OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Gemini (Google) — fallback provider
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Groq (OpenAI-compatible) — fallback provider
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# NVIDIA NIM / build API (OpenAI-compatible) — fallback provider
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Anthropic (Claude) — last in priority chain
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# LLM_MAX_TOKENS=2000
# LLM_TEMPERATURE=0.0

# --- Langfuse observability (LLM tracing) ---
# Traces model + token usage for every LLM call. Active when both keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com